#!/usr/bin/env bash
# Secret credentials template — copy to env.secret.sh and fill in values.
# env.secret.sh is gitignored and must NEVER be committed.
#
# Usage: source rl_coding_game/env.secret.sh

# CodingGame session cookie (required for download_games.py)
CG_SESSION=

# Azure service principal — only needed for non-interactive / CI authentication.
# Leave empty when using interactive `az login`.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
