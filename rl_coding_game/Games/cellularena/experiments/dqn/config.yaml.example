# Cellularena Rainbow DQN CPU profile. Copy to config.yaml for a run.
env:
  map_height: 8
  #map_width: 16  # Defaults to map_height * 2 when unset.
  #wall_ratio: 0.2  # Fraction of the left half turned into obstacles; random 0-0.35 when unset.
  #protein_ratio: 0.1  # Fraction of the left half seeded with proteins; random 0-0.15 when unset.
  obs_history_steps: 1
  reward_shaping: false
experiment:
  iterations: 20
  checkpoint_interval: 5
  replay_capacity: 10000
  # false: stop training-runner games at capacity; train on the saved buffer.
  # Evaluation games still run if evaluation_interval is nonzero.
  replay_buffer_rotation: true
  train_batch_size: 32
  replay_alpha: 0.6
  replay_beta: 0.4
  runner:
    num_env_runners: 1
  learner:
    num_gpus: 0
  evaluator:
    # Runs in parallel with training: current policy vs the previous checkpoint.
    evaluation_interval: 5
    evaluation_num_env_runners: 1
    evaluation_duration: 10
    evaluation_duration_unit: episodes
    evaluation_explore: false
    # Save the first evaluation game of each round as a TV replay.
    save_evaluation_play: false
league_pool:
  enabled: false
  max_size: 8
dqn:
  num_atoms: 1
  noisy: true
  dueling: true
  double_q: true
